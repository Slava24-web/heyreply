generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AppStatus {
  APPLIED
  VIEWED
  SCREENING
  TEST_TASK
  INTERVIEW
  FINAL_INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  DECLINED
  NO_RESPONSE
}

enum WorkFormat {
  OFFICE
  HYBRID
  REMOTE
}

enum SalaryType {
  GROSS
  NET
}

enum Locale {
  ru
  en
}

enum Theme {
  light
  dark
  system
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String
  name              String
  locale            Locale     @default(ru)
  theme             Theme      @default(system)
  defaultCurrency   String     @default("RUB")
  defaultSalaryType SalaryType @default(GROSS)
  ghostingDays      Int        @default(14)
  resetTokenHash    String?
  resetTokenExpires DateTime?
  /// Proof of consent: when, to which version of the legal documents and from which IP. Null for accounts created before consent was collected.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  termsAcceptedIp   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions     Session[]
  apiTokens    ApiToken[]
  deletedImports   DeletedImport[]
  applications Application[]
  companies    Company[]
  positions    Position[]
  locations    Location[]
  sources      Source[]
  tags         Tag[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Set when the token was rotated (not logged out) — distinguishes a multi-tab race from token theft
  rotatedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Personal token for integrations (browser extension). Only a SHA-256 hash is stored; the token is shown once.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  tokenHash  String    @unique
  /// First characters of the token, to tell tokens apart in the UI
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model Company {
  id             String        @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  usageCount     Int           @default(0)
  lastUsedAt     DateTime?
  website        String?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   Application[]

  @@unique([userId, normalizedName])
}

model Position {
  id             String        @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  groupName      String?
  usageCount     Int           @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   Application[]

  @@unique([userId, normalizedName])
}

model Location {
  id             String        @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  country        String?
  usageCount     Int           @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   Application[]

  @@unique([userId, normalizedName])
}

model Source {
  id             String        @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  domain         String?
  isSystem       Boolean       @default(false)
  usageCount     Int           @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   Application[]

  @@unique([userId, normalizedName])
}

model Tag {
  id             String           @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  usageCount     Int              @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   ApplicationTag[]

  @@unique([userId, normalizedName])
}

model Application {
  id              String      @id @default(uuid())
  userId          String
  companyId       String
  positionId      String
  sourceId        String?
  locationId      String?
  workFormat      WorkFormat?
  vacancyUrl      String?
  salaryFrom      Int?
  salaryTo        Int?
  currency        String?
  salaryType      SalaryType?
  offerAmount     Int?
  appliedAt       DateTime    @default(now())
  status          AppStatus   @default(APPLIED)
  maxStage        Int         @default(1)
  firstResponseAt DateTime?
  finishedAt      DateTime?
  coverLetter     Boolean     @default(false)
  rejectionReason String?
  nextStepAt      DateTime?
  note            String?
  archivedAt      DateTime?
  deletedAt       DateTime?
  /// Job board the application was imported from (hh, linkedin, …) and the vacancy id there
  externalSource  String?
  externalId      String?
  importedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company          @relation(fields: [companyId], references: [id])
  position      Position         @relation(fields: [positionId], references: [id])
  source        Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  location      Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  statusHistory StatusHistory[]
  tags          ApplicationTag[]

  @@unique([userId, externalSource, externalId])
  @@index([userId, appliedAt])
  @@index([userId, status])
}

model ApplicationTag {
  applicationId String
  tagId         String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([applicationId, tagId])
}

model StatusHistory {
  id            String      @id @default(uuid())
  applicationId String
  fromStatus    AppStatus?
  toStatus      AppStatus
  changedAt     DateTime    @default(now())
  comment       String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
}

/// Left behind when a deleted imported application is purged for good: just the board's vacancy id, so the extension
/// and e-mail import don't add back what the user deleted on purpose. No other data about the application is kept.
model DeletedImport {
  userId         String
  externalSource String
  externalId     String
  deletedAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, externalSource, externalId])
}
