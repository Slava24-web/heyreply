# Docker Compose secrets. Copy to .env and replace both values:
#   openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
# Set to true when served over HTTPS (enables HSTS, upgrade-insecure-requests, Secure cookies)
HTTPS_ENABLED=false
COOKIE_SECURE=false

# Operator details shown in the legal documents (/privacy, /terms, /consent). Required in production.
# Name: who runs the service (a person or a company, not a web address). Address: the operator's postal address (not an e-mail).
LEGAL_OPERATOR_NAME=Full Name or Company Ltd
LEGAL_OPERATOR_ADDRESS=Street 1, City, Country
# Where users send data requests
LEGAL_CONTACT_EMAIL=privacy@example.com
# LEGAL_HOSTING=                           # hosting provider and country, e.g. "Hetzner Online GmbH, Germany"

# Search engine webmaster tools (optional): the content value of the verification meta tag from Google Search Console / Yandex Webmaster
# GOOGLE_SITE_VERIFICATION=
# YANDEX_VERIFICATION=

# Donation link shown in settings, the sidebar and the legal pages (https only; leave empty to hide it)
# DONATE_URL=https://paypal.me/your-name
# Extension store links (buttons appear on the landing page and in Settings once set; https only)
# EXTENSION_CHROME_URL=https://chromewebstore.google.com/detail/heyreply/<id>
# EXTENSION_FIREFOX_URL=https://addons.mozilla.org/firefox/addon/heyreply/

# Password-reset e-mails. Any SMTP provider works (Resend, Brevo, ...); without SMTP_URL no mail is sent.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="heyreply <no-reply@heyreply.example>"

# Per-user caps (defaults shown)
# MAX_APPLICATIONS_PER_USER=5000
# MAX_DICTIONARY_ITEMS_PER_USER=2000

# ---- Production only (docker-compose.prod.yml, see docs/DEPLOY.md) ----
# SITE_ADDRESS=heyreply.example.com        # domain without scheme; Caddy issues the TLS certificate
# WEB_ORIGIN=https://heyreply.example.com
# IMAGE_TAG=sha-abc1234                    # written by deploy/deploy.sh
# Off-site backups (Cloudflare R2 / Backblaze B2, S3 API)
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=heyreply-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_AGE_RECIPIENT=age1...             # PUBLIC key from `age-keygen`; keep the private key off the server
# BACKUP_PING_URL=                         # optional healthchecks.io-style URL: alerts when a backup does not run
